# APO: Automatic Prompt Optimization for Persona-based LLM Agents
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Keys and Authentication
# =============================================================================

# OpenAI API Key (required for most operations)
OPENAI_API_KEY=your-openai-api-key-here

# Alternative LLM providers (optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# =============================================================================
# Model Configuration
# =============================================================================

# Default models for different optimization stages
GRADIENT_MODEL=gpt-4o-mini
EDITOR_MODEL=gpt-4o
EVALUATOR_MODEL=gpt-4o-mini

# Model temperatures (0.0 = deterministic, 1.0 = creative)
GRADIENT_TEMPERATURE=0.7
EDITOR_TEMPERATURE=0.3
EVALUATOR_TEMPERATURE=0.1

# =============================================================================
# Optimization Settings
# =============================================================================

# Score threshold for considering optimization successful
SCORE_THRESHOLD=0.8

# Maximum optimization iterations
MAX_ITERATIONS=10

# Minimum improvement threshold for convergence
MIN_IMPROVEMENT_THRESHOLD=0.01

# Batch size for gradient analysis
BATCH_SIZE=5

# Maximum failed samples for gradient generation
MAX_GRADIENT_SAMPLES=20

# =============================================================================
# Advanced Features
# =============================================================================

# Enable/disable advanced optimization features
ENABLE_GRADIENT_MINI_BATCH=false
GRADIENT_MINI_BATCH_SIZE=10
ENABLE_PROMPT_CANDIDATES=false
NUM_PROMPT_CANDIDATES=3
MONTE_CARLO_SAMPLE_SIZE=10
ENABLE_BEAM_SEARCH=false
BEAM_WIDTH=3
ENABLE_GRADIENT_MEMORY=false
GRADIENT_MEMORY_SIZE=5

# =============================================================================
# Performance and Parallelism
# =============================================================================

# Number of parallel LM evaluation requests
N_PARALLEL=16

# =============================================================================
# Logging and Monitoring
# =============================================================================

# Enable Weights & Biases logging
ENABLE_WANDB=false
WANDB_PROJECT=apo-optimization
WANDB_RUN_NAME=apo-run-$(date +%Y%m%d-%H%M%S)

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# File Paths
# =============================================================================

# Default data and output paths
DEFAULT_DATA_PATH=data/task1_train.json
DEFAULT_OUTPUT_PATH=results/
CHECKPOINT_DIR=checkpoints/

# =============================================================================
# Development and Debugging
# =============================================================================

# Enable debug mode
DEBUG=false

# Enable verbose output
VERBOSE=false

# =============================================================================
# Security and Privacy
# =============================================================================

# Disable telemetry and external calls
DISABLE_TELEMETRY=true

# =============================================================================
# Notes
# =============================================================================
# 
# 1. Copy this file to .env: cp env.example .env
# 2. Fill in your actual API keys and configuration values
# 3. Never commit .env to version control
# 4. For production, use secure secret management
# 5. Adjust model settings based on your API quota and requirements
